variable "name" {
  description = "Name prefix, e.g. g4-merlion-staging. Instances are <name>-<key>-db; the env CI role may only manage RDS resources named <name>*"
  type        = string
}

variable "databases" {
  description = "One entry per PostgreSQL instance, e.g. { accounts = { db_name = \"accountsdb\" } }"
  type = map(object({
    db_name = string
  }))
}

variable "vpc_id" {
  type = string
}

variable "db_subnet_group_name" {
  description = "Subnet group over the isolated database subnets (created by the network module)"
  type        = string
}

variable "allowed_security_groups" {
  description = "Security groups that may connect on 5432, by a fixed name, e.g. { eks_cluster = <sg id> }. The names are the rules' keys, so they must be known before apply; the IDs can come from other resources."
  type        = map(string)
}

variable "engine_version" {
  description = "PostgreSQL major version only (e.g. 18), so RDS picks the latest minor and upgrades it"
  type        = string
}

variable "instance_class" {
  description = "Instance class for every database, e.g. db.t4g.small"
  type        = string
}

variable "allocated_storage_gb" {
  description = "Initial gp3 storage per database (20 GB is the gp3 minimum)"
  type        = number
  default     = 20
}

variable "max_allocated_storage_gb" {
  description = "Storage autoscaling ceiling per database"
  type        = number
  default     = 50
}

variable "multi_az" {
  description = "Standby in the second AZ. false for staging (cost), true for prod (survives an AZ outage)"
  type        = bool
  default     = false
}

variable "backup_retention_days" {
  description = "Automated backups, kept in this region only"
  type        = number
  default     = 7
}

variable "deletion_protection" {
  description = "Block deletes. Off while environments are rebuilt often"
  type        = bool
  default     = false
}

variable "skip_final_snapshot" {
  description = "No snapshot on destroy (environments use synthetic data and are rebuilt often)"
  type        = bool
  default     = true
}

variable "master_username" {
  description = "Admin user. The password is generated by RDS and kept in Secrets Manager"
  type        = string
  default     = "bankadmin"
}

variable "kms_key_arn" {
  description = "KMS key for storage, snapshots and backups"
  type        = string
}

variable "secret_kms_key_arn" {
  description = "KMS key for the RDS-managed master password secret in Secrets Manager"
  type        = string
}
